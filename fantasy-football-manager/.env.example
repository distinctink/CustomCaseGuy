# ---------------------------------------------------------------------------
# Yahoo Fantasy Sports API — REQUIRED
# ---------------------------------------------------------------------------
# Generate these at https://developer.yahoo.com/apps/create/
# See README.md "What I need from you" for the exact settings to pick.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Must byte-for-byte match the Redirect URI you registered in the Yahoo app.
# Yahoo requires https. The auth flow spins up a local listener here and mints a
# self-signed cert; your browser warns once and you accept it.
# If Yahoo rejects a localhost URI on your account, register any https URL you
# control (it never has to actually load) and run `npm run auth -- --manual`.
YAHOO_REDIRECT_URI=https://localhost:8765/callback

# Pin your league so you never have to pass it. Find it with:
#   npm run auth        (prints your leagues at the end)
#   npm run league -- list
# Format: <gameKey>.l.<leagueId>, e.g. 461.l.123456
YAHOO_LEAGUE_KEY=

# "nfl" resolves to the current season automatically. Only pin a numeric game
# key (e.g. 461) if you need a specific past season.
YAHOO_GAME_KEY=nfl

# ---------------------------------------------------------------------------
# Safety
# ---------------------------------------------------------------------------
# DRY_RUN=1 makes every write a no-op that logs the exact XML it would have
# sent. Leave this ON until you have watched it make a few decisions you agree
# with, then remove it to go live.
DRY_RUN=1

# ---------------------------------------------------------------------------
# Notifications (optional)
# ---------------------------------------------------------------------------
# Any endpoint that accepts a JSON POST: Slack/Discord incoming webhook,
# ntfy.sh, Make.com. Used for trade approvals and executed-move alerts.
# Without it, alerts still go to the console and data/alerts.log.
NOTIFY_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Paths and logging (optional — defaults are fine)
# ---------------------------------------------------------------------------
# TOKEN_PATH=data/yahoo-tokens.json
# STATE_PATH=data/state.json
# STRATEGY_PATH=config/strategy.json
# APPROVALS_PATH=data/approvals.json
# ALERT_LOG_PATH=data/alerts.log

# debug | info | warn | error
LOG_LEVEL=info
