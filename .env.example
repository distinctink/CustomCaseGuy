# Shopify Storefront API
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your_storefront_access_token
NEXT_PUBLIC_SHOPIFY_DOMAIN=customcaseguy.com

# Shopify Admin API (for product setup script)
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxx
SHOPIFY_MYSHOPIFY_DOMAIN=distinct-ink.myshopify.com

# Database (Vercel Postgres)
DATABASE_URL=postgres://...

# AWS S3
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET=ccg-assets
NEXT_PUBLIC_S3_BUCKET=ccg-assets

# SudoMock API
SUDOMOCK_API_KEY=your_sudomock_key

# Google Gemini API
GEMINI_API_KEY=your_gemini_key

# Admin
NEXT_PUBLIC_ADMIN_PASSWORD=change_this_password

# Contact form webhook (Make.com, Zapier, etc.)
CONTACT_WEBHOOK_URL=https://hook.us1.make.com/your-webhook-id
